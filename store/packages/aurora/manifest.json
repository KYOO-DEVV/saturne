{
  "id": "aurora",
  "name": "Aurore",
  "author": "Saturne",
  "version": "1.1.0",
  "type": "theme",
  "description": "Une aurore boréale douce qui ondule derrière l'interface : fond animé fluide, verre dépoli, teintes réglables.",
  "tags": ["animé", "verre", "nuit"],
  "preview": ["#050d1c", "#1fb6a6", "#8b5cf6"],
  "thumb": "thumb.png",
  "options": [
    {"id": "speed", "type": "range", "label": "Durée d'un cycle", "min": 12, "max": 90, "step": 2, "unit": "s", "default": 36},
    {"id": "power", "type": "range", "label": "Intensité", "min": 20, "max": 100, "step": 5, "default": 80},
    {"id": "palette", "type": "choice", "label": "Couleurs", "choices": [{"value": "teal", "label": "Boréale"}, {"value": "violet", "label": "Violette"}, {"value": "rose", "label": "Rose"}], "default": "teal"},
    {"id": "glass", "type": "toggle", "label": "Panneaux en verre dépoli", "default": true}
  ]
}
